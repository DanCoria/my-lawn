# Create a `.env` file at the project root with these values:
VITE_SUPABASE_PROJECT_ID="your_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_anon_key"
VITE_SUPABASE_URL="https://your_project_id.supabase.co"

# Supabase Edge Function secrets — configure in Supabase, never in Vercel/browser env.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_SECRET_KEY=""
GEMINI_API_KEY=""
NETWORK_HMAC_SECRET=""
AI_SCANS_ENABLED="false"
APP_ALLOWED_ORIGINS="https://my-lawn.vercel.app,http://localhost:5173,http://127.0.0.1:5173"
AI_DAILY_GLOBAL_LIMIT="100"
AI_DAILY_GUEST_LIMIT="50"
AI_GUEST_NETWORK_LIMIT="3"
GEMINI_GUEST_MODEL="gemini-2.5-flash-lite"
GEMINI_DIAGNOSIS_MODEL="gemini-2.5-flash"

# Reserved for the public Guest Preview phase. Leave blank until Turnstile is configured.
VITE_GUEST_PREVIEW_ENABLED="false"
VITE_MANUAL_IDENTITY_LINKING_ENABLED="false"
VITE_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
